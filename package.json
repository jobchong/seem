{
  "name": "seem",
  "private": true,
  "version": "0.0.0",
  "description": "Harness-independent visual verification tooling.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "cli:hello": "pnpm --filter @seem/cli exec tsx src/index.ts hello --json",
    "mcp:start": "pnpm --filter @seem/mcp start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.5.0",
    "eslint": "10.0.3",
    "globals": "17.4.0",
    "prettier": "3.8.1",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "4.1.0"
  }
}
